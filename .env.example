# Banco de dados (PostgreSQL). Local dev:
# - scripts/db.ps1 (Postgres nativo) ou docker-compose.yml (porta 5432, usuário postgres).
# Produção (Vercel + Neon):
DATABASE_URL="postgresql://postgres@localhost:5432/mestredofestudo"
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# IA gratuita (sem cartão de crédito) com failover automático:
# o app tenta Gemini → Groq → OpenRouter; se todos falharem,
# usa o corretor local de fallback. Deixe tudo vazio para usar só o local.
# Chaves gratuitas (cada uma em conta/projeto diferente multiplica a cota):
GEMINI_API_KEYS=""            # https://aistudio.google.com/apikey (1+ chaves, separadas por vírgula)
GROQ_API_KEY=""               # https://console.groq.com/keys
OPENROUTER_API_KEY=""         # https://openrouter.ai/keys (modelos :free)

# Modelos (opcional — padrões sensatos são usados se vazio)
GEMINI_MODELS="gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3-flash-preview"
GROQ_MODEL="llama-3.3-70b-versatile"
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# Ajustes de failover (opcional)
# AI_TIMEOUT_MS=30000    # timeout por chamada
# AI_COOLDOWN_MS=60000   # pausa de uma chave após esgotar cota (429)